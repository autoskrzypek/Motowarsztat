{
  "manifest_version": 3,
  "name": "Motowarsztat Pomocnik",
  "version": "0.1.0",
  "description": "Pomocnik do pracy w systemie Motowarsztat: panel na stronie, odczyt danych, szybkie akcje.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Motowarsztat Pomocnik",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
